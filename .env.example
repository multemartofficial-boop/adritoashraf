# Copy to .env.local for local development. In production, set the same keys in
# Vercel -> Project Settings -> Environment Variables (or cPanel "Setup Node.js App").
# Never upload or commit real .env files.

# --- Site ---------------------------------------------------------------------
# Public base URL (no trailing slash). In production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ----------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- ONE-TIME SETUP ONLY (used by `npm run setup:supabase`) ----------------------
# Delete these 3 lines after setup succeeds. Never put them in cPanel.
# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Storage --------------------------------------------------------------------
STORAGE_PUBLIC_BUCKET=site-media
STORAGE_PRIVATE_BUCKET=booking-attachments

# --- Cron (long random string, e.g. `openssl rand -hex 32`) ---------------------
# Sent by the daily cPanel cron job as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me-to-a-long-random-string

# --- Email ---------------------------------------------------------------------
# Preferred on Vercel: Resend (https://resend.com). Create an API key and verify
# your sending domain, then set:
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="Adrito Ashraf <booking@adritoashraf.com>"   (must be on the verified domain)
# SMTP is the fallback when no RESEND_API_KEY is set — from cPanel -> Email Accounts.
RESEND_API_KEY=
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="Adrito Ashraf <no-reply@yourdomain.com>"
# Where new-booking notifications are sent (defaults to the admin login email)
ADMIN_NOTIFY_EMAIL=you@example.com
# "auto" (default): Resend when RESEND_API_KEY is set, else SMTP.
# "resend" | "smtp" force one transport; "log" prints emails to the server console.
EMAIL_TRANSPORT=auto
